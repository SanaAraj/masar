# masar environment
#
# None of these are required for the mock backend used in the tests and the
# quickstart. Provide only the keys for the real backends your routing config
# references. Keys are read from the environment at startup by name; they are
# never stored in the routing config itself.

# Which routing table to load (defaults to the committed heuristic v0 table).
MASAR_CONFIG=configs/routing.v0.yaml

# OpenAI-compatible endpoint (a frontier reference model, or a local server).
# The routing config names which variable to read via `api_key_env`.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
